# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token that agents send to /api/v1/*. Generate a long random string.
AGENT_API_TOKEN=

# Public URL of the deployed app, used for sign-in links. Example: https://pm.amkorholdings.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers → API keys, and the signing secret of the webhook pointing at /api/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Plaid (dashboard.plaid.com → Developers → Keys). PLAID_ENV is sandbox or production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Bearer token the 5am scheduler sends to /api/cron/bank-sync. Generate a long random string.
CRON_SECRET=
