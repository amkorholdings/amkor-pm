# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token that agents send to /api/v1/*. Generate a long random string.
AGENT_API_TOKEN=

# Public URL of the deployed app, used for sign-in links. Example: https://pm.amkorholdings.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
